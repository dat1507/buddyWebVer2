# ── Environment variables ──
# Block all .env variants except the committed template
.env
.env.*
!.env.example

# ── Dependencies ──
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# ── Build output ──
dist/
build/
*.egg-info/

# ── IDE / Editor ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS files ──
.DS_Store
Thumbs.db
Desktop.ini

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Docker ──
docker-compose.override.yml

# ── Python / Backend ──
*.egg
*.egg-info/
.eggs/
*.pyo
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# ── Misc ──
*.local
.local/
.vercel
