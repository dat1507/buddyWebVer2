# Local Docker Compose settings. POSTGRES_PASSWORD is required and must remain uncommitted.
POSTGRES_DB=vgu_buddy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=5173

# FastAPI runtime credential for the least-privilege vgu_buddy_runtime role.
# Copy the appropriate direct/session/transaction URL from Supabase Connect and require TLS.
# For full-stack Compose, use the service host postgres; for host processes use 127.0.0.1.
# Both local variants may explicitly use sslmode=disable.
DATABASE_URL=

# Alembic-only privileged direct connection. Never load this in the FastAPI runtime.
DATABASE_MIGRATION_URL=

# Local Compose only: unique password assigned post-migration to vgu_buddy_runtime.
# DATABASE_URL must contain this same password. Production role provisioning is separate.
LOCAL_RUNTIME_DATABASE_PASSWORD=

# Shared async Redis for readiness and future realtime/job coordination.
# Full-stack Compose overrides the host to redis. Host processes use 127.0.0.1.
# Production must use a credentialed rediss:// URL and an environment-specific prefix.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=vgu-buddy:local:ops:v1

# Exact browser origins allowed to send cookies to the API. Never use * with credentials.
# Local Compose uses the trusted HTTPS localhost entrypoint; staging/production use first-party HTTPS.
CORS_ALLOWED_ORIGINS=https://localhost:5173

# Dedicated HS256 key: URL-safe base64 for at least 32 random bytes. Do not reuse another secret.
# Generate a value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=

# Independent HMAC key for signed CSRF tokens. Generate another unique value; do not reuse JWT.
AUTH_CSRF_SECRET=

# Local, staging, and production browser workflows use HTTPS and Secure __Host- cookies.
AUTH_COOKIE_SECURE=true

# Server-only Supabase Storage access. Use the project URL and a secret/service-role key.
# The browser must never receive this key or upload directly with privileged credentials.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server-only transactional email provider. Use a send-only Resend API key and verified sender.
# Never expose the key through VITE_* or commit a populated value.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Exact HTTPS browser origin used to build email-verification links.
# The dedicated URL-safe base64 key must decode to exactly 32 random bytes.
PUBLIC_APP_BASE_URL=https://localhost:5173
EMAIL_VERIFICATION_SEALING_KEY=

# Explicit local mode permits memory; production defaults to requiring shared TLS Redis.
APP_ENV=local
RATE_LIMIT_STORAGE_URI=memory://
# All backend workers for one environment must share URI and environment-specific key prefix.
RATE_LIMIT_KEY_PREFIX=vgu-buddy:local:auth:v1

# Production: APP_ENV=production and RATE_LIMIT_STORAGE_URI=<operator-provided rediss URL>.
# Redis URL is server-only and may contain credentials: never use VITE_ or commit it.
# Forwarded IPs must be resolved by the server using only an audited proxy-peer allowlist.
# Do not set FORWARDED_ALLOW_IPS=* or guess production proxy ranges.

# Database URLs, POSTGRES_PASSWORD, auth secrets, provider keys, and SUPABASE_SECRET_KEY are server-only.
# Never add a VITE_ prefix or commit populated values.
