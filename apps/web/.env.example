# Same-origin API path; Vite proxies this to the local backend.
VITE_API_URL=/api
VITE_GA_ID=G-XXXXXXXXXX
# Retained for post-deployment dynamic adapter development; static Landing ignores this.
VITE_EVENT_SLIDER_USE_MOCKS=true
# Event surfaces are independent and require the exact value "true" to enable.
# The retired VITE_EVENTS_LAUNCH_ENABLED flag is ignored.
VITE_ADMIN_EVENTS_ENABLED=false
VITE_PUBLIC_EVENTS_ENABLED=false
